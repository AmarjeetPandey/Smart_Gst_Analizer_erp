# ======================================
# SMARTGST AI ERP - Environment Variables
# ======================================

# Database Configuration (managed/online PostgreSQL)
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
DATABASE_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Configuration
SECRET_KEY=replace-with-a-random-value-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP Configuration (Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=#################
SMTP_PASSWORD=################
SMTP_FROM_EMAIL=#############

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Application Configuration
APP_NAME=SmartGST AI ERP
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,xlsx,xls,doc,docx
UPLOAD_DIR=./uploads

# ML Configuration
ML_MODEL_PATH=./ml-models
ENABLE_OCR=True
ENABLE_FRAUD_DETECTION=True
ENABLE_DEMAND_FORECASTING=True

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
REMEMBER_LOGIN_DAYS=30

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# API Keys (for internal use only)
API_KEY_INTERNAL=internal-api-key-change-in-production

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily  # daily, weekly, monthly
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# Email Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=True
SEND_DUE_REMINDERS=True
SEND_STOCK_ALERTS=True
SEND_PAYMENT_ALERTS=True

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Currency
DEFAULT_CURRENCY=INR
DECIMAL_PLACES=2
